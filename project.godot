; Engine configuration file.
config_version=5

[application]

config/name="Tap Racers"
run/main_scene="res://scenes/main_menu.tscn"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.051, 0.071, 0.11, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Profile="*res://scripts/profile.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
